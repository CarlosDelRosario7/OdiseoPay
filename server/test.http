@baseUrl = http://127.0.0.1:5000
@auth_token = {{login.response.body.$.access_token}}
@categoria_id = 1
@proveedor_id = 1
@cliente_id = 1
#volver a poner usuario_id = 1 si inicia la base de datos desde cero, ya que el primer usuario creado es el admin y tiene id = 1
@usuario_id = 3
@producto_id = 1
@inventario_id = 1
@compra_id = 1
@detalle_compra_id = 1
@venta_id = 1
@detalle_venta_id = 1
@movimiento_id = 1

### 01. Health publico
GET {{baseUrl}}/api/health

### 02. Registro inicial: ejecutar solo si la tabla usuarios esta vacia
# El primer usuario debe tener rol Admin.
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "nombre": "Administrador",
  "usuario": "admin",
  "contrasena": "admin1234",
  "rol": "Admin"
}

### 03. Login Admin
# Ejecuta primero esta peticion; @auth_token se obtiene automaticamente de su respuesta.
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "usuario": "admin",
  "contrasena": "admin1234"
}

### 04. Crear usuario Vendedor
POST {{baseUrl}}/api/usuarios
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "nombre": "Joel La Para",
  "usuario": "vendedor1",
  "contrasena": "1234",
  "rol": "Vendedor"
}

### 05. Login Vendedor (opcional)
# @name vendedor_login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "usuario": "vendedor1",
  "contrasena": "1234"
}

### 06. Crear categoria
POST {{baseUrl}}/api/categorias
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "nombre": "Comidas",
  "descripcion": "Alimentos procesados y enlatados"
}

### 07. Listar categorias
GET {{baseUrl}}/api/categorias?page=1&per_page=20
Authorization: Bearer {{auth_token}}

### 08. Obtener categoria
GET {{baseUrl}}/api/categorias/{{categoria_id}}
Authorization: Bearer {{auth_token}}

### 09. Actualizar categoria
PATCH {{baseUrl}}/api/categorias/{{categoria_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "descripcion": "Bebidas, refrescos y agua"
}

### 10. Crear proveedor
POST {{baseUrl}}/api/proveedores
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "nombre": "Brayan La Batea",
  "telefono": "8091234567",
  "correo": "brayan_la_batea@example.com",
  "direccion": "Calle C #67, Santo Domingo"
}

### 11. Listar proveedores
GET {{baseUrl}}/api/proveedores?page=1&per_page=20
Authorization: Bearer {{auth_token}}

### 12. Obtener proveedor
GET {{baseUrl}}/api/proveedores/{{proveedor_id}}
Authorization: Bearer {{auth_token}}

### 13. Actualizar proveedor
PATCH {{baseUrl}}/api/proveedores/{{proveedor_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "telefono": "8291234567"
}

### 14. Crear cliente
POST {{baseUrl}}/api/clientes
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "nombre": "Argenys",
  "apellido": "No Bulto",
  "correo": "argenys_no_bulto@example.com",
  "telefono": "8292345678",
  "direccion": "Calle C Usted #45, Santo Domingo"
}

### 15. Listar clientes
GET {{baseUrl}}/api/clientes?page=1&per_page=20
Authorization: Bearer {{auth_token}}

### 16. Obtener cliente
GET {{baseUrl}}/api/clientes/{{cliente_id}}
Authorization: Bearer {{auth_token}}

### 17. Actualizar cliente
PATCH {{baseUrl}}/api/clientes/{{cliente_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "telefono": "8492345678"
}

### 18. Listar usuarios
GET {{baseUrl}}/api/usuarios?page=1&per_page=20
Authorization: Bearer {{auth_token}}

### 19. Obtener usuario
GET {{baseUrl}}/api/usuarios/{{usuario_id}}
Authorization: Bearer {{auth_token}}

### 20. Actualizar usuario
PATCH {{baseUrl}}/api/usuarios/{{usuario_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "nombre": "Eirick The Best"
}

### 21. Crear producto
POST {{baseUrl}}/api/productos
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "nombre": "Agua 600ml",
  "descripcion": "Agua embotellada",
  "precio_compra": "5.00",
  "precio_venta": "8.50",
  "id_categoria": {{categoria_id}},
  "id_proveedor": {{proveedor_id}}
}

### 22. Listar productos
GET {{baseUrl}}/api/productos?page=1&per_page=20
Authorization: Bearer {{auth_token}}

### 23. Filtrar productos por nombre/categoria/proveedor
GET {{baseUrl}}/api/productos?nombre=Agua&id_categoria={{categoria_id}}&id_proveedor={{proveedor_id}}
Authorization: Bearer {{auth_token}}

### 24. Obtener producto
GET {{baseUrl}}/api/productos/{{producto_id}}
Authorization: Bearer {{auth_token}}

### 25. Actualizar producto
PATCH {{baseUrl}}/api/productos/{{producto_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "precio_venta": "9.00"
}

### 26. Crear registro de inventario
POST {{baseUrl}}/api/inventario
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id_producto": {{producto_id}},
  "cantidad": 10,
  "stock_minimo": 5,
  "ubicacion": "Estante A1"
}

### 27. Listar inventario
GET {{baseUrl}}/api/inventario?page=1&per_page=20
Authorization: Bearer {{auth_token}}

### 28. Obtener inventario
GET {{baseUrl}}/api/inventario/{{inventario_id}}
Authorization: Bearer {{auth_token}}

### 29. Actualizar inventario
PATCH {{baseUrl}}/api/inventario/{{inventario_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "stock_minimo": 8,
  "ubicacion": "Estante B2"
}

### 30. Registrar compra: aumenta stock y crea movimiento ENTRADA
POST {{baseUrl}}/api/compras
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id_proveedor": {{proveedor_id}},
  "detalles": [
    {
      "id_producto": {{producto_id}},
      "cantidad": 20,
      "precio": "5.00"
    }
  ]
}

### 31. Listar compras
GET {{baseUrl}}/api/compras?page=1&per_page=20
Authorization: Bearer {{auth_token}}

### 32. Obtener compra
GET {{baseUrl}}/api/compras/{{compra_id}}
Authorization: Bearer {{auth_token}}

### 33. Actualizar compra
PATCH {{baseUrl}}/api/compras/{{compra_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id_proveedor": {{proveedor_id}}
}

### 34. Crear detalle de compra directo
POST {{baseUrl}}/api/detalle-compras
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id_compra": {{compra_id}},
  "id_producto": {{producto_id}},
  "cantidad": 2,
  "precio": "5.00"
}

### 35. Listar detalles de compra
GET {{baseUrl}}/api/detalle-compras?page=1&per_page=20
Authorization: Bearer {{auth_token}}

### 36. Obtener detalle de compra
GET {{baseUrl}}/api/detalle-compras/{{detalle_compra_id}}
Authorization: Bearer {{auth_token}}

### 37. Actualizar detalle de compra
PATCH {{baseUrl}}/api/detalle-compras/{{detalle_compra_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "cantidad": 3
}

### 38. Registrar venta Admin: disminuye stock y crea movimiento SALIDA
POST {{baseUrl}}/api/ventas
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id_cliente": {{cliente_id}},
  "detalles": [
    {
      "id_producto": {{producto_id}},
      "cantidad": 2,
      "precio": "9.00"
    }
  ]
}

### 39. Registrar venta Vendedor (usa el token capturado en el login de vendedor)
POST {{baseUrl}}/api/ventas
Authorization: Bearer {{vendedor_login.response.body.$.access_token}}
Content-Type: application/json

{
  "id_cliente": {{cliente_id}},
  "detalles": [
    {
      "id_producto": {{producto_id}},
      "cantidad": 1,
      "precio": "9.00"
    }
  ]
}

### 40. Listar ventas
GET {{baseUrl}}/api/ventas?page=1&per_page=20
Authorization: Bearer {{auth_token}}

### 41. Obtener venta
GET {{baseUrl}}/api/ventas/{{venta_id}}
Authorization: Bearer {{auth_token}}

### 42. Actualizar venta
PATCH {{baseUrl}}/api/ventas/{{venta_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id_cliente": {{cliente_id}}
}

### 43. Crear detalle de venta directo
POST {{baseUrl}}/api/detalle-ventas
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id_venta": {{venta_id}},
  "id_producto": {{producto_id}},
  "cantidad": 1,
  "precio": "9.00"
}

### 44. Listar detalles de venta
GET {{baseUrl}}/api/detalle-ventas?page=1&per_page=20
Authorization: Bearer {{auth_token}}

### 45. Obtener detalle de venta
GET {{baseUrl}}/api/detalle-ventas/{{detalle_venta_id}}
Authorization: Bearer {{auth_token}}

### 46. Actualizar detalle de venta
# En un PATCH parcial envia solo los campos que quieras cambiar; no envies
# "id_producto": null. Usa el ID numerico real del detalle y del producto.
PATCH {{baseUrl}}/api/detalle-ventas/{{detalle_venta_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "cantidad": 2
}

### 47. Crear movimiento de inventario
POST {{baseUrl}}/api/movimientos-inventario
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "id_producto": {{producto_id}},
  "tipo": "AJUSTE",
  "cantidad": 1,
  "motivo": "Conteo fisico",
  "id_usuario": {{usuario_id}}
}

### 48. Listar movimientos de inventario
GET {{baseUrl}}/api/movimientos-inventario?page=1&per_page=20
Authorization: Bearer {{auth_token}}

### 49. Obtener movimiento de inventario
GET {{baseUrl}}/api/movimientos-inventario/{{movimiento_id}}
Authorization: Bearer {{auth_token}}

### 50. Actualizar movimiento de inventario
PATCH {{baseUrl}}/api/movimientos-inventario/{{movimiento_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "motivo": "Conteo fisico actualizado"
}

### 51. Vendedor no puede listar proveedores: debe responder 403
GET {{baseUrl}}/api/proveedores
Authorization: Bearer {{vendedor_login.response.body.$.access_token}}

### 52. Peticion sin token: debe responder 401
GET {{baseUrl}}/api/productos

### 53. Eliminar detalle de compra [DESTRUCTIVO]
DELETE {{baseUrl}}/api/detalle-compras/{{detalle_compra_id}}
Authorization: Bearer {{auth_token}}

### 54. Eliminar detalle de venta [DESTRUCTIVO]
DELETE {{baseUrl}}/api/detalle-ventas/{{detalle_venta_id}}
Authorization: Bearer {{auth_token}}

### 55. Eliminar movimiento [DESTRUCTIVO]
DELETE {{baseUrl}}/api/movimientos-inventario/{{movimiento_id}}
Authorization: Bearer {{auth_token}}

### 56. Eliminar inventario [DESTRUCTIVO]
DELETE {{baseUrl}}/api/inventario/{{inventario_id}}
Authorization: Bearer {{auth_token}}

### 57. Eliminar venta [DESTRUCTIVO]
DELETE {{baseUrl}}/api/ventas/{{venta_id}}
Authorization: Bearer {{auth_token}}

### 58. Eliminar compra [DESTRUCTIVO]
DELETE {{baseUrl}}/api/compras/{{compra_id}}
Authorization: Bearer {{auth_token}}

### 59. Eliminar producto [DESTRUCTIVO]
# Este producto no se puede borrar mientras conserve detalles de ventas/compras,
# inventario o movimientos. La respuesta esperada en ese caso es 409.
DELETE {{baseUrl}}/api/productos/{{producto_id}}
Authorization: Bearer {{auth_token}}

### 60. Eliminar cliente [DESTRUCTIVO]
DELETE {{baseUrl}}/api/clientes/{{cliente_id}}
Authorization: Bearer {{auth_token}}

### 61. Eliminar proveedor [DESTRUCTIVO]
DELETE {{baseUrl}}/api/proveedores/{{proveedor_id}}
Authorization: Bearer {{auth_token}}

### 62. Eliminar categoria [DESTRUCTIVO]
DELETE {{baseUrl}}/api/categorias/{{categoria_id}}
Authorization: Bearer {{auth_token}}

### 63. Eliminar usuario [DESTRUCTIVO]
DELETE {{baseUrl}}/api/usuarios/{{usuario_id}}
Authorization: Bearer {{auth_token}}
